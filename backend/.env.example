# Local development (scripts/dev-exec fills database and Redis URLs dynamically).
ICTSC_API_ADDRESS=:8080
ICTSC_API_READ_HEADER_TIMEOUT=5s
ICTSC_API_SHUTDOWN_TIMEOUT=15s
ICTSC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
ICTSC_DEV_FAKE_MODE=true
ICTSC_SECURE_COOKIES=false
ICTSC_ALLOW_INSECURE_UPSTREAMS=false

# PostgreSQL / Redis. Set explicit URLs when running the API without scripts/dev-exec.
ICTSC_DATABASE_URL=postgres://ictsc:password@127.0.0.1:5432/ictscore?sslmode=disable
ICTSC_REDIS_URL=redis://127.0.0.1:6379/0

# Discord OAuth (required when ICTSC_DEV_FAKE_MODE=false).
ICTSC_DISCORD_CLIENT_ID=
ICTSC_DISCORD_CLIENT_SECRET=
ICTSC_DISCORD_CONTESTANT_REDIRECT_URI=https://score.example.com/api/v1/auth/discord/callback
ICTSC_DISCORD_ADMIN_REDIRECT_URI=https://score.example.com/api/v1/admin/auth/discord/callback
# Optional role ID -> team code JSON. Enables registration without invitation codes.
# Teams must already exist. Requires contestant guild ID; zero/multiple team matches deny login.
ICTSC_DISCORD_ROLE_TEAMS=
ICTSC_DISCORD_CONTESTANT_GUILD_ID=
ICTSC_DISCORD_ADMIN_GUILD_ID=
ICTSC_DISCORD_ADMIN_ROLE_IDS=

# GitHub content refresh / Actions OIDC (required in production).
ICTSC_GITHUB_API_BASE_URL=https://api.github.com
ICTSC_GITHUB_API_TOKEN=
ICTSC_GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com
ICTSC_GITHUB_OIDC_AUDIENCE=
ICTSC_GITHUB_REPOSITORY_ID=
ICTSC_GITHUB_REPOSITORY=owner/content-repository
ICTSC_GITHUB_REF=refs/heads/main
ICTSC_GITHUB_WORKFLOW_REF=owner/content-repository/.github/workflows/refresh.yml@refs/heads/main
ICTSC_GITHUB_MANIFEST_PATH=content/manifest.yaml
ICTSC_GITHUB_OIDC_DISCOVERY_URL=

# SState HTTP request/callback contract (required in production).
ICTSC_SSTATE_BASE_URL=https://sstate.example.com
ICTSC_SSTATE_REQUEST_TOKEN=
ICTSC_SSTATE_CALLBACK_TOKEN=
ICTSC_CALLBACK_BASE_URL=https://score.example.com
