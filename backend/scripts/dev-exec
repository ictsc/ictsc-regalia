#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
compose_file="$script_dir/../compose.yaml"

postgres_address=$(docker compose -f "$compose_file" port postgres 5432)
redis_address=$(docker compose -f "$compose_file" port redis 6379)

if [ -z "$postgres_address" ] || [ -z "$redis_address" ]; then
    echo "開発用サービスが起動していません。docker compose -f backend/compose.yaml up -d --waitを実行してください。" >&2
    exit 1
fi

export ICTSC_DATABASE_URL="postgres://ictsc:password@127.0.0.1:${postgres_address##*:}/ictscore?sslmode=disable"
export ICTSC_REDIS_URL="redis://127.0.0.1:${redis_address##*:}/0"
export ICTSC_ALLOWED_ORIGINS=${ICTSC_ALLOWED_ORIGINS:-http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080}
export ICTSC_DEV_FAKE_MODE=${ICTSC_DEV_FAKE_MODE:-true}
export ICTSC_SECURE_COOKIES=${ICTSC_SECURE_COOKIES:-false}

exec "$@"
